<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/kylow_soft">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp"><Button android:id="@+id/menuButton" android:layout_width="52dp" android:layout_height="48dp" android:text="☰"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kylow" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/kylow_ink"/><TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PC not connected" android:textSize="12sp" android:textColor="@color/kylow_blue"/></LinearLayout><Button android:id="@+id/newChatButton" android:layout_width="56dp" android:layout_height="48dp" android:text="+"/></LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="18dp"><LinearLayout android:id="@+id/welcomePanel" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kylow" android:textSize="46sp" android:textStyle="bold" android:textColor="@color/kylow_ink"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="He’s just a good boy." android:textSize="20sp" android:textColor="@color/kylow_blue"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hi! I’m Kylow. What can I help with?" android:textSize="20sp" android:textColor="@color/kylow_ink" android:layout_marginTop="30dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good People Better Days. ♡" android:textSize="18sp" android:textColor="@color/kylow_blue" android:layout_marginTop="28dp"/></LinearLayout><TextView android:id="@+id/responseText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/kylow_ink" android:textSize="17sp" android:visibility="gone"/></FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"><LinearLayout android:id="@+id/toolBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:orientation="horizontal"><Button android:id="@+id/filesButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Files"/><Button android:id="@+id/webButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Web"/><Button android:id="@+id/tasksButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Tasks"/><Button android:id="@+id/pairButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="PC"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:background="@color/kylow_white" android:padding="6dp"><Button android:id="@+id/toolsButton" android:layout_width="48dp" android:layout_height="48dp" android:text="+"/><EditText android:id="@+id/messageInput" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:hint="Ask Kylow anything…" android:background="@android:color/transparent" android:paddingHorizontal="12dp"/><Button android:id="@+id/sendButton" android:layout_width="58dp" android:layout_height="48dp" android:text="➤"/></LinearLayout></LinearLayout></LinearLayout>