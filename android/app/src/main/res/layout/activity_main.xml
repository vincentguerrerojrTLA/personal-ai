<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/kylow_soft">
<LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingHorizontal="14dp"><TextView android:id="@+id/menuButton" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="☰" android:textSize="24sp" android:textColor="@color/kylow_ink"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kylow" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/kylow_ink" android:paddingStart="8dp"/><TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Online" android:textSize="13sp" android:textColor="@color/kylow_blue"/><TextView android:id="@+id/newChatButton" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="＋" android:textSize="26sp" android:textColor="@color/kylow_ink"/></LinearLayout>
<ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="14dp"><LinearLayout android:id="@+id/welcomePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<ImageView android:layout_width="match_parent" android:layout_height="230dp" android:scaleType="centerCrop" android:src="@drawable/kylow_ui_600" android:contentDescription="Kylow approved artwork"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/kylow_composer" android:padding="14dp" android:text="🐾  Hi! I’m Kylow.\nAsk me anything, give me a task, or let’s work on something together." android:textColor="@color/kylow_ink" android:textSize="15sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Start with Kylow" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/kylow_ink"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/chatHomeButton" android:layout_width="0dp" android:layout_height="62dp" android:layout_weight="1" android:text="💬 Chat" android:textAllCaps="false"/><Button android:id="@+id/tasksHomeButton" android:layout_width="0dp" android:layout_height="62dp" android:layout_weight="1" android:text="☑ Tasks" android:textAllCaps="false"/><Button android:id="@+id/filesHomeButton" android:layout_width="0dp" android:layout_height="62dp" android:layout_weight="1" android:text="📁 Files" android:textAllCaps="false"/><Button android:id="@+id/webHomeButton" android:layout_width="0dp" android:layout_height="62dp" android:layout_weight="1" android:text="◎ Web" android:textAllCaps="false"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp"><Button android:id="@+id/pcHomeButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:text="▣ PC" android:textAllCaps="false"/><Button android:id="@+id/createHomeButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:text="▧ Create" android:textAllCaps="false"/><Button android:id="@+id/learnHomeButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:text="▤ Learn" android:textAllCaps="false"/><Button android:id="@+id/moreHomeButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:text="⚙ More" android:textAllCaps="false"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Quick Actions" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/kylow_ink"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp"><Button android:id="@+id/canDoButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="What can you do?" android:textAllCaps="false"/><Button android:id="@+id/planButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Help me plan" android:textAllCaps="false"/><Button android:id="@+id/imageButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Create image" android:textAllCaps="false"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingVertical="16dp" android:text="Good People. Better Days. ♡     v0.8.0" android:textColor="@color/kylow_ink" android:textSize="13sp"/>
</LinearLayout><TextView android:id="@+id/chatText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="@color/kylow_ink" android:textSize="17sp" android:lineSpacingExtra="6dp"/></LinearLayout></ScrollView>
<LinearLayout android:id="@+id/toolBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:orientation="horizontal" android:paddingHorizontal="14dp"><Button android:id="@+id/filesButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Files" android:textAllCaps="false"/><Button android:id="@+id/webButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Web" android:textAllCaps="false"/><Button android:id="@+id/tasksButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Tasks" android:textAllCaps="false"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="10dp"><TextView android:id="@+id/toolsButton" android:layout_width="42dp" android:layout_height="52dp" android:gravity="center" android:text="＋" android:textSize="25sp" android:textColor="@color/kylow_ink"/><EditText android:id="@+id/messageInput" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="54dp" android:maxHeight="130dp" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:hint="Message Kylow…" android:textColor="@color/kylow_ink" android:textColorHint="@color/kylow_muted" android:background="@drawable/kylow_composer" android:inputType="textCapSentences|textMultiLine" android:paddingHorizontal="18dp"/><TextView android:id="@+id/sendButton" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:background="@drawable/kylow_send" android:text="➤" android:textSize="20sp" android:textColor="@color/kylow_white"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:orientation="horizontal" android:background="@color/kylow_white"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂\nHome" android:textColor="@color/kylow_blue"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▢\nChat" android:textColor="@color/kylow_ink"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="☑\nTasks" android:textColor="@color/kylow_ink"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="♡\nMemories" android:textColor="@color/kylow_ink"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▦\nMore" android:textColor="@color/kylow_ink"/></LinearLayout>
</LinearLayout>