<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/kylow_soft">
<LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"><Button android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp" android:text="☰"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kylow" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/kylow_ink" android:paddingStart="10dp"/><TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ready on this phone" android:textSize="12sp" android:textColor="@color/kylow_blue"/><Button android:id="@+id/newChatButton" android:layout_width="48dp" android:layout_height="48dp" android:text="+"/></LinearLayout>
<ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="400dp" android:orientation="vertical" android:padding="16dp"><LinearLayout android:id="@+id/welcomePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="50dp"><ImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/kylow_brand_mark" android:contentDescription="Kylow"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="What can I help with?" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/kylow_ink" android:layout_marginTop="16dp"/></LinearLayout><TextView android:id="@+id/chatText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/kylow_ink" android:textSize="17sp" android:lineSpacingExtra="5dp"/></LinearLayout></ScrollView>
<LinearLayout android:id="@+id/toolBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:orientation="horizontal" android:paddingHorizontal="12dp"><Button android:id="@+id/filesButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Files"/><Button android:id="@+id/webButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Web"/><Button android:id="@+id/tasksButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Tasks"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:padding="10dp"><Button android:id="@+id/toolsButton" android:layout_width="48dp" android:layout_height="56dp" android:text="+"/><EditText android:id="@+id/messageInput" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="56dp" android:maxHeight="160dp" android:layout_weight="1" android:hint="Message Kylow" android:textColor="@color/kylow_ink" android:textColorHint="@color/kylow_blue" android:background="@color/kylow_white" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine" android:padding="14dp" android:scrollbars="vertical"/><Button android:id="@+id/sendButton" android:layout_width="58dp" android:layout_height="56dp" android:text="➤"/></LinearLayout>
</LinearLayout>