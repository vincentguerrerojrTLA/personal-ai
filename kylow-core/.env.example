KYLOW_ENVIRONMENT=development

KYLOW_PROVIDER=auto

KYLOW_API_VERSION=v1

KYLOW_DATABASE_URL=sqlite+aiosqlite:///./kylow.db

KYLOW_REQUEST_TIMEOUT_SECONDS=120


# ==============================================
# OPENAI
# ==============================================

KYLOW_OPENAI_API_KEY=

KYLOW_OPENAI_MODEL=gpt-5.6-sol


# ==============================================
# ANTHROPIC
# ==============================================

KYLOW_ANTHROPIC_API_KEY=

KYLOW_ANTHROPIC_MODEL=claude-opus-5


# ==============================================
# GOOGLE
# ==============================================

KYLOW_GOOGLE_API_KEY=

KYLOW_GOOGLE_MODEL=gemini-3.8-flash




# ==============================================
# GROQ - KYLOW FREE
# ==============================================

KYLOW_GROQ_API_KEY=

KYLOW_GROQ_MODEL=openai/gpt-oss-120b
